{
  "enabledPlugins": {
    "claude-hud@claude-hud": true
  },
  "effortLevel": "high",
  "model": "opus",
  "outputStyle": "Planning",
  "enabledMcpServers": ["serena", "sequential-thinking", "shrimp-task-manager"],
  "permissions": {
    "allow": [
      "mcp__serena",
      "mcp__sequential-thinking",
      "mcp__shrimp-task-manager"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.claude/hooks/notification-exit-plan-mode.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.claude/hooks/notification-ask-user-question.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"/Users/junhokim/.claude/hooks/notification-stop.sh\""
          }
        ]
      }
    ]
  }
}
