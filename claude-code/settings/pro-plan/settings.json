{
  "model": "sonnet",
  "effortLevel": "medium",
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_THINKING_TOKENS": "10000"
  },
  "outputStyle": "Planning",
  "enabledPlugins": {
    "claude-hud@claude-hud": true
  },
  "permissions": {
    "allow": [
      "mcp__serena",
      "mcp__shrimp-task-manager"
    ]
  },
  "enabledMcpServers": [
    "serena",
    "shrimp-task-manager"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.claude/hooks/notification-exit-plan-mode.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.claude/hooks/notification-ask-user-question.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/junhokim/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"/Users/junhokim/.claude/hooks/notification-stop.sh\""
          }
        ]
      }
    ]
  }
}
